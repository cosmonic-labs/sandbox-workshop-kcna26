[53.551511, "o", "\u001b[1mWorkshop doctor\u001b[0m: checks only, changes nothing.\r\n\r\n\u001b[1mYour computer\u001b[0m\r\n"]
[53.551591, "o", "  \u001b[32mOK  \u001b[0m  Darwin arm64 is supported\r\n"]
[53.551633, "o", "\r\n\u001b[1mRequired\u001b[0m\r\n"]
[55.378919, "o", "  \u001b[32mOK  \u001b[0m  wash 2.12.0 in .tools/wash (the wasmCloud CLI; pushes the components)\r\n"]
[56.040349, "o", "  \u001b[32mOK  \u001b[0m  Docker is running (16 GB for containers)\r\n"]
[56.0414, "o", "  \u001b[32mOK  \u001b[0m  kind (/tmp/workshop.14oM7r/sandbox-workshop-kcna26/.tools/kind)\r\n"]
[56.042125, "o", "  \u001b[32mOK  \u001b[0m  kubectl (/tmp/workshop.14oM7r/sandbox-workshop-kcna26/.tools/kubectl)\r\n"]
[56.042858, "o", "  \u001b[32mOK  \u001b[0m  helm (/tmp/workshop.14oM7r/sandbox-workshop-kcna26/.tools/helm)\r\n"]
[56.043071, "o", "  \u001b[32mOK  \u001b[0m  curl\r\n"]
[56.043437, "o", "  \u001b[32mOK  \u001b[0m  nc\r\n"]
[56.050009, "o", "  \u001b[32mOK  \u001b[0m  port 28180 is free\r\n"]
[56.063016, "o", "  \u001b[32mOK  \u001b[0m  prebuilt components in artifacts/ match SHA256SUMS\r\n"]
[56.101065, "o", "  \u001b[32mOK  \u001b[0m  the guide in artifacts/guide.wasm matches the READMEs\r\n"]
[56.106321, "o", "  \u001b[32mOK  \u001b[0m  prebuilt databases in databases/ match SHA256SUMS\r\n"]
[56.106345, "o", "\r\n\u001b[1mOptional\u001b[0m\r\n"]
[56.572839, "o", "  \u001b[32mOK  \u001b[0m  wasm-tools 1.258.3 (lists a component's imports)\r\n"]
[56.573322, "o", "  \u001b[32mOK  \u001b[0m  sqlite3 (only for make databases; the workshop uses the prebuilt databases/*.db)\r\n"]
[56.637142, "o", "  \u001b[32mOK  \u001b[0m  Rust 1.98.1 with wasm32-wasip2 (build the tools yourself)\r\n\r\n"]
[56.63717, "o", "\u001b[32mReady.\u001b[0m Next: make up, then follow steps/01-agent/README.md.\r\n"]

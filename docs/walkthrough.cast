[348.190268, "o", "-rw-r--r--@ 1 bhayes  wheel   181780 Nov  7 22:11 artifacts/tool_curl.wasm\r\n-rw-r--r--@ 1 bhayes  wheel   296735 Nov  7 22:11 artifacts/tool_gh.wasm\r\n-rw-r--r--@ 1 bhayes  wheel  1178728 Nov  7 22:11 artifacts/tool_sqlite.wasm\r\n"]
[350.202753, "o", "\u001b[0;33m# * `curl` is about 180 KB (182,276 bytes) \u001b[0m\r\n"]
[353.227755, "o", "\u001b[0;33m# * `sqlite3` is about 1.2 MB (1,173,947)\u001b[0m\r\n"]
[355.246851, "o", "\u001b[0;33m# * `gh` is about 300 KB (297,582) \u001b[0m\r\n"]
[357.261516, "o", "\u001b[0;33m# These are the component files only; the wasmCloud host that runs them is a separate, long-running \r\n# pod.\u001b[0m\r\n"]
[362.286154, "o", "\u001b[0;33m# Full transcript: `expected-output.txt`.\u001b[0m\r\n"]
[363.298195, "o", "\r\n\u001b[1;36m# Step 2: Give the agent curl, then try to make it escape\u001b[0m\r\n"]
[365.391611, "o", "\r\n\u001b[1;36m# Build your own (optional)\u001b[0m\r\n"]
[367.40872, "o", "\u001b[0;33m# Skip this section to use the prebuilt curl.\u001b[0m\r\n"]
[370.427334, "o", "\u001b[0;33m# You need Rust 1.98.1 with the `wasm32-wasip2` target (`make doctor` checks). `curl` is pure Rust, \r\n# so no C toolchain is needed.\u001b[0m\r\n"]
[376.446272, "o", "\u001b[0;33m# To make it yours, open `components/tool-curl/src/lib.rs` and change the message `\"saved {} bytes to \r\n# {path}\\n\"`, for example to `\"saved {} bytes to {path} (built by me)\\n\"`. Then build it, which \r\n# writes `target/wasm32-wasip2/release/tool_curl.wasm`:\u001b[0m\r\n"]

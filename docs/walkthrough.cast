[552.904471, "o", "\u001b[0;33m# `attacker.mock-sites.svc` plays the server of someone who has hijacked the agent, the address a \r\n# planted instruction would tell it to send data to. It is on the network and would answer, but it \r\n# isn't in curl's grant, so the host refuses the request before it leaves.\u001b[0m\r\n"]

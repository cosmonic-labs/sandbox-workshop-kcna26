[432.603471, "o", "  import wasi:http/types@0.3.0;\r\n  import wasi:http/client@0.3.0;\r\n  import wasi:filesystem/types@0.2.9;\r\n  import wasi:filesystem/preopens@0.2.9;\r\n"]
[434.630439, "o", "\u001b[0;33m# The prebuilt curl and your build print the same four lines:\u001b[0m\r\n"]
[437.707595, "o", "\u001b[0;33m# `curl` imports an HTTP client and no sockets, so every request goes through the host, which checks \r\n# it against the grant. The filesystem is for `-o`, and the manifest limits it to one folder. (The \r\n# full import list also has the command line basics Rust's standard library needs: stdout, \r\n# environment, clocks.)\u001b[0m\r\n"]

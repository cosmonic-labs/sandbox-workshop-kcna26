[307.591037, "o", "[user] fetch http://api.mock-sites.svc/data. Then sqlite .tables\r\n[model] call curl({\"arguments\":\"-s http://api.mock-sites.svc/data\"})\r\n[tool curl] error: {\"not-found\":\"no tool named curl in this workload\"}\r\n[model] call sqlite({\"sql\":\".tables\"})\r\n[tool sqlite] error: {\"not-found\":\"no tool named sqlite in this workload\"}\r\n[model] Done. Here is what each step returned: curl: ERROR: {\"not-found\":\"no tool named curl in this workload\"} | sqlite: ERROR: {\"not-found\":\"no tool named sqlite in this workload\"}\r\n"]
[309.614282, "o", "\u001b[0;33m# The model follows both, one after the other, and would follow an instruction hidden in a web page \r\n# the same way. Both calls are refused: the workload has neither tool.\u001b[0m\r\n"]
[317.684352, "o", "\r\n\u001b[1;36m# Look inside (optional)\u001b[0m\r\n"]

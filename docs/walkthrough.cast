[728.926051, "o", "\u001b[0;33m# The same command with another path. `payroll.db` is a valid database on the host pod's disk, but it \r\n# is not in this component's filesystem, so SQLite can't open it. The tool reports SQLite's \"unable \r\n# to open database\" as `access-denied`.\u001b[0m\r\n"]

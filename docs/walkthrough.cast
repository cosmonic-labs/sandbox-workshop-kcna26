[1070.860145, "o", "  import workshop:toolbox/github-api@0.4.0;\r\n"]
[1072.876974, "o", "\u001b[0;33m# One import: the capability. No HTTP client, no sockets, no files, no secrets. Whatever the model \r\n# asks `gh` to do, the only door out is the plugin.\u001b[0m\r\n"]
[1079.997893, "o", "\r\n\u001b[1;36m# Done. make clean deletes the cluster and the registry.\u001b[0m\r\n"]

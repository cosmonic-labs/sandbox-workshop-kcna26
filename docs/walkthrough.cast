[234.34488, "o", "\r\n"]
[234.344979, "o", "cluster   kubectl context kind-workshop-toolbox\r\nregistry  workshop-toolbox-registry:5000 inside the cluster (127.0.0.1:15052 from here)\r\ningress   http://127.0.0.1:28180  (use curl with a Host: header)\r\nguide     http://guide.localhost:28180  (the steps, in your browser)\r\n"]
[236.360524, "o", "\u001b[0;33m# Every command in the steps runs from the `sandbox-workshop-kcna26` folder. In each new terminal, \r\n# `cd` there and run the `export PATH` line again, so `kubectl` and `wasm-tools` are the pinned ones. \r\n# `make up` creates a kind cluster named `workshop-toolbox` and switches your kubectl context to it.\u001b[0m\r\n"]

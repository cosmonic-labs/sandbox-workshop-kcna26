[474.800935, "o", "\u001b[0;33m# `workloaddeployment-mine.yaml` is `workloaddeployment.yaml` with one change: the `curl` image is \r\n# `tool-curl:mine`. Built again? Run `make push-build`, then `kubectl delete workloaddeployment \r\n# toolbox-agent` and apply again, so the host fetches the new push.\u001b[0m\r\n"]
[482.862382, "o", "\u001b[0;33m# The same agent as step 1, with curl added: one component, and its interface listed under \r\n# `hostInterfaces` so the toolbox plugin offers it to the agent. The grant, the same in both \r\n# manifests: one host, one folder.\u001b[0m\r\n"]

[166.607995, "o", "  \u001b[32mOK  \u001b[0m  wash 2.12.0 in .tools/wash (the wasmCloud CLI; pushes the components)\r\n"]
[167.153871, "o", "  \u001b[32mOK  \u001b[0m  Docker is running (16 GB for containers)\r\n"]
[167.154802, "o", "  \u001b[32mOK  \u001b[0m  kind (/tmp/workshop.gB6AzD/sandbox-workshop-kcna26/.tools/kind)\r\n"]
[167.155568, "o", "  \u001b[32mOK  \u001b[0m  kubectl (/tmp/workshop.gB6AzD/sandbox-workshop-kcna26/.tools/kubectl)\r\n"]

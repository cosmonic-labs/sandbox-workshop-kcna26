[167.205185, "o", "  \u001b[32mOK  \u001b[0m  the guide in artifacts/guide.wasm matches the READMEs\r\n"]
[167.208515, "o", "  \u001b[32mOK  \u001b[0m  prebuilt databases in databases/ match SHA256SUMS\r\n\r\n\u001b[1mOptional\u001b[0m\r\n"]

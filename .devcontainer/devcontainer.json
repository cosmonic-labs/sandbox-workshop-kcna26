{
  "name": "Sandboxing on Kubernetes with WebAssembly",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "INSTALL_RUST": "true"
    }
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "onCreateCommand": "cargo fetch --locked || true",
  "postCreateCommand": "mkdir -p .tools && ln -sf /opt/workshop-tools/* .tools/ && make tools && make doctor",
  "forwardPorts": [
    28180
  ],
  "portsAttributes": {
    "28180": {
      "label": "workshop ingress (agents and mock sites; use curl with a Host header)",
      "onAutoForward": "silent"
    },
    "15052": {
      "label": "cluster registry",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "bytecodealliance.wit-idl"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "steps/01-agent/README.md"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  }
}

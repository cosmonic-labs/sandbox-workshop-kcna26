/// The workshop's own interfaces: three tools, the GitHub capabilities behind
/// gh and sign-in, the model, and the worlds that say what each component may
/// touch.
///
/// The tools follow typed-tool conventions. Each function takes
/// one record whose fields are the tool's arguments, each interface has its
/// own `variant error`, and every interface, type, case, field and function
/// has a doc comment. A host that offers a tool to a model builds the tool's
/// definition from these names, types and doc comments, so the comments are
/// written for the model as much as for a programmer.
package workshop:toolbox@0.4.0;

// ---------------------------------------------------------------------------
// The tools: familiar command line tools, each its own component.
//
// Each one takes what you would type after the program's name, so you can
// teach it new tricks without changing this file. curl and sqlite3 are
// famous for escapes (curl reaching the cloud metadata service, sqlite3's
// .shell); as components they have nothing to escape to. Every tool
// ships as its own component, so each one gets its own capabilities (a
// folder, network hosts) from the workload manifest. The agent harness
// reaches them through the agent SDK's `tools` interface (cosmonic:agent),
// which the toolbox host plugin serves by calling the tool components in the
// agent's own workload.
// ---------------------------------------------------------------------------

/// curl: HTTP requests from a command line, only to the hosts in this
/// component's allowedHosts.
@since(version = 0.4.0)
interface curl {
  /// Why a curl call failed.
  ///
  /// Payload strings are diagnostic. Their wording is not stable, and
  /// programs should not parse them.
  variant error {
    /// The arguments are malformed, such as an unknown option or no URL.
    /// The payload says which and why.
    invalid-argument(string),
    /// This tool may not do this: the host is not in its allowedHosts, or a
    /// file is outside its folder. The payload names what was refused.
    access-denied(string),
    /// The request was allowed but did not complete: the name did not
    /// resolve, the connection failed or timed out. The payload says what
    /// happened.
    network(string),
    /// Any other failure. Treat it as a generic failure.
    other(option<string>),
  }

  /// Arguments for `run`.
  record run-args {
    /// What you would type after `curl`, such as
    /// `-s -H "Accept: application/json" http://api.mock-sites.svc/data`.
    arguments: string,
  }

  /// Run curl with these arguments and return what it prints: the response
  /// body, plus headers with -i, or a short summary with -o.
  run: async func(args: run-args) -> result<string, error>;
}

/// sqlite3: SQL over the database files in this component's folder.
@since(version = 0.4.0)
interface sqlite {
  /// Why a sqlite call failed.
  ///
  /// Payload strings are diagnostic. Their wording is not stable, and
  /// programs should not parse them.
  variant error {
    /// The statement is empty or malformed, or names an unknown
    /// dot-command. The payload is SQLite's message.
    invalid-argument(string),
    /// This tool may not do this: the database or an attached file is
    /// outside its folder, or the folder is read only. The payload names it.
    access-denied(string),
    /// No database file exists at this path. The payload names it.
    not-found(string),
    /// Any other failure. Treat it as a generic failure.
    other(option<string>),
  }

  /// Arguments for `query`.
  record query-args {
    /// SQL to run, such as `select title from talks limit 5`, or a
    /// dot-command such as `.tables` or `.schema talks`.
    sql: string,
  }

  /// Run SQL against this tool's database and return the rows, one per
  /// line, with columns separated by " | ".
  query: async func(args: query-args) -> result<string, error>;
}

/// gh: read pull requests on GitHub from a command line, like GitHub's own
/// `gh`. Requests go through the github-api capability; this tool holds no
/// token, reaches nothing else, and only reads.
@since(version = 0.4.0)
interface gh {
  /// Why a gh call failed.
  ///
  /// Payload strings are diagnostic. Their wording is not stable, and
  /// programs should not parse them.
  variant error {
    /// The arguments are malformed, such as an unknown command or flag.
    /// The payload says which and why.
    invalid-argument(string),
    /// The github-api plugin refused the request (a method, host or path it
    /// does not allow), or this tool does not offer the command at all,
    /// such as one that writes. The payload names what was refused.
    access-denied(string),
    /// The request did not reach GitHub, or GitHub refused it for its rate
    /// limit. The payload says what happened.
    network(string),
    /// Any other failure, such as GitHub answering that a pull request does
    /// not exist. Treat it as a generic failure.
    other(option<string>),
  }

  /// Arguments for `run`.
  record run-args {
    /// What you would type after `gh`, such as
    /// `pr list -R wasmCloud/wasmCloud` or `pr view 4321`.
    arguments: string,
  }

  /// Run gh with these arguments and return what it prints.
  run: async func(args: run-args) -> result<string, error>;
}

/// GitHub's REST API, as a capability. A host component plugin serves it: it
/// sends each request to api.github.com and nowhere else, only for the read
/// paths it allows, and adds the signed-in user's token when there is one. A
/// caller never sees the token.
@since(version = 0.4.0)
interface github-api {
  /// What GitHub answered.
  record response {
    /// HTTP status, such as 200 or 404.
    status: u16,
    /// The headers a caller needs to pace itself: GitHub's x-ratelimit-*
    /// headers and retry-after, lower case. No others.
    headers: list<tuple<string, string>>,
    /// The response body, usually JSON.
    body: list<u8>,
  }

  /// Why a request got no answer from GitHub.
  variant send-error {
    /// The plugin refused to send it: a method other than GET, or a path it
    /// does not allow. The payload names the rule.
    refused(string),
    /// It was allowed, but did not complete: GitHub could not be reached, or
    /// the answer was too large. The payload says what happened.
    failed(string),
  }

  /// Send one request to api.github.com. `method` is GET (anything else is
  /// refused); `path-and-query` is relative to the API, such as
  /// `/repos/wasmCloud/wasmCloud/pulls?state=open`.
  send: async func(method: string, path-and-query: string) -> result<response, send-error>;
}

/// Signing in to GitHub, as a capability. The same plugin as github-api
/// serves it, runs the sign-in itself, and keeps the token it gets back in
/// its own memory, for the calling workload only. A caller never sees the
/// token.
///
/// Two ways to sign in. The browser flow (`begin-web`, `complete-web`) is
/// GitHub's OAuth web application flow with PKCE: the person approves on
/// github.com, GitHub sends their browser back with a single-use code, and
/// the plugin trades that code for a token. The caller passes the code
/// along but cannot use it, because the trade also needs the plugin's PKCE
/// verifier and the app's client secret. The code flow (`start`, `status`)
/// is GitHub's device flow: the person enters a short code on github.com.
/// It suits a browser that can't come back to a fixed address, such as a
/// Codespaces forwarded port.
@since(version = 0.4.0)
interface github-auth {
  /// What the person needs to finish signing in.
  record device-prompt {
    /// The code to enter, such as `WDJB-MJHT`.
    user-code: string,
    /// Where to enter it: https://github.com/login/device.
    verification-uri: string,
    /// Seconds until the code expires.
    expires-in: u32,
  }

  /// Whether this workload is signed in.
  variant sign-in-status {
    /// Not signed in: requests go to GitHub without a token.
    signed-out,
    /// Waiting for the person to enter the code.
    pending(device-prompt),
    /// Signed in, as this GitHub login.
    signed-in(string),
  }

  /// Why sign-in could not start, continue or complete.
  ///
  /// Payload strings are diagnostic. Their wording is not stable, and
  /// programs should not parse them.
  variant auth-error {
    /// Sign-in is not set up on this platform: the OAuth app's client id,
    /// client secret or redirect address is not configured. The payload
    /// says which.
    not-set-up(string),
    /// The browser flow's state matches no sign-in this workload began, or
    /// that sign-in expired or was already completed. Begin again.
    unknown-state(string),
    /// Any other failure: GitHub refusing or expiring a code, or GitHub not
    /// answering. The payload says what happened.
    failed(string),
  }

  /// Start the code flow: ask GitHub for a code, with no scopes.
  start: async func() -> result<device-prompt, auth-error>;

  /// Whether this workload is signed in, checking with GitHub when a code is
  /// waiting. The error says why sign-in ended, such as an expired code.
  status: async func() -> result<sign-in-status, auth-error>;

  /// Forget this workload's token.
  sign-out: async func() -> result<_, auth-error>;

  /// Begin the browser flow. The plugin makes a fresh state and PKCE
  /// verifier, keeps them for this workload for ten minutes, and returns the
  /// github.com address to send the person's browser to. It asks for no
  /// scopes. GitHub sends the browser back to the redirect address in the
  /// plugin's own config, never one a caller picks.
  begin-web: async func() -> result<string, auth-error>;

  /// Complete the browser flow with the `code` and `state` GitHub sent the
  /// browser back with. The plugin checks the state, trades the code for a
  /// token (with its verifier and the app's client secret), keeps the token
  /// and returns the signed-in login. A state works once.
  complete-web: async func(code: string, state: string) -> result<string, auth-error>;
}

// ---------------------------------------------------------------------------
// The model.
// ---------------------------------------------------------------------------

/// Shapes the agent harness and the model use to talk to each other.
@since(version = 0.3.0)
interface types {
  /// One turn of the conversation.
  ///
  /// role is "user", "assistant" or "tool". For a tool turn, tool-name says
  /// which tool produced the content. For an assistant turn that asked for a
  /// tool, content is the tool call as JSON: {"name": ..., "arguments": {...}}.
  record message {
    /// "user", "assistant" or "tool".
    role: string,
    /// The text of the turn.
    content: string,
    /// For a tool turn, the tool that produced the content.
    tool-name: option<string>,
  }

  /// What the model is told about one tool. parameters is a JSON Schema.
  record tool-def {
    /// The name the model uses to call the tool.
    name: string,
    /// What the tool does, in words the model reads.
    description: string,
    /// A JSON Schema for the tool's arguments.
    parameters: string,
  }

  /// A request from the model to run one tool. arguments is a JSON object.
  record tool-call {
    /// The tool's name, as in its `tool-def`.
    name: string,
    /// The arguments as a JSON object.
    arguments: string,
  }

  /// The model either answers in text or asks for a tool.
  variant completion {
    /// An answer for the user.
    text(string),
    /// A request to run one tool.
    call(tool-call),
  }
}

/// A language model. The workshop ships one implementation, model-scripted:
/// offline, deterministic, and gullible on purpose.
@since(version = 0.3.0)
interface model {
  use types.{message, tool-def, completion};

  /// The model's next step, given the conversation so far and the tools it
  /// may call. The error is the model's own failure, such as an endpoint
  /// that did not answer.
  complete: async func(messages: list<message>, tools: list<tool-def>) -> result<completion, string>;
}

// ---------------------------------------------------------------------------
// Worlds: what each component imports and exports. Everything is WASI 0.3:
// the functions above are async and HTTP is wasi:http@0.3.0.
// ---------------------------------------------------------------------------

/// The agent harness. It answers HTTP and imports one model, the agent SDK's
/// `tools` (cosmonic:agent), and GitHub sign-in, and nothing else. `tools`
/// lists and calls the tool
/// components the workload's manifest gives it, so the manifest, not the
/// harness code, decides which tools (and which capabilities) the agent has.
/// The github-api plugin serves sign-in; every step's manifest declares it.
/// The harness never imports github-api, so it can't read GitHub itself.
@since(version = 0.4.0)
world agent {
  import model: model;
  import cosmonic:agent/tools@0.4.1;
  import github-auth;
  export wasi:http/handler@0.3.0;
}

/// The scripted model: no imports at all.
@since(version = 0.3.0)
world model-provider {
  export model;
}

/// The curl tool: outgoing HTTP, only to the hosts in this component's
/// allowedHosts, and files only in the folder its manifest mounts.
@since(version = 0.4.0)
world curl-tool {
  import wasi:http/client@0.3.0;
  export curl;
}

/// The sqlite tool: database files in the folder its manifest mounts, and
/// nothing else.
@since(version = 0.4.0)
world sqlite-tool {
  export sqlite;
}

/// The gh tool: no outgoing HTTP, no sockets, no files, no token. Its only
/// way to GitHub is the github-api capability.
@since(version = 0.4.0)
world gh-tool {
  import github-api;
  export gh;
}

/// The github-api host component plugin, installed on the host group by the
/// platform: outgoing HTTP, which its own allowedHosts limit to github.com
/// (sign-in) and api.github.com, its config (the OAuth app's client id,
/// client secret and redirect address), random bytes for each browser sign-in's state and PKCE
/// verifier, and the host's answer to "which workload is calling", which
/// keys each token to one workload.
@since(version = 0.4.0)
world github-api-plugin {
  import wasi:http/client@0.3.0;
  import wasi:config/store@0.2.0-rc.1;
  import wasi:random/random@0.3.0;
  import wasmcloud:host/identity@0.1.6;
  export github-api;
  export github-auth;
}

/// Not part of the toolbox: the mock sites (an ordinary API page and a
/// stand-in for an attacker's server), served from one HTTP component on
/// the names of the Services in k8s/sites.yaml.
@since(version = 0.3.0)
world mock-sites {
  export wasi:http/handler@0.3.0;
}

/// Not part of the toolbox: the workshop guide, the step READMEs as web
/// pages (components/guide). It serves HTTP and imports no files and no
/// network.
@since(version = 0.4.0)
world guide {
  export wasi:http/handler@0.3.0;
}

/// The toolbox host plugin: serves the agent SDK's `tools` interface to a
/// workload by calling the typed tool components in that same workload.
@since(version = 0.4.0)
world toolbox-plugin {
  import curl;
  import sqlite;
  import gh;
  import wasmcloud:host/identity@0.1.6;
  import wasmcloud:host/workload-call@0.1.6;
  export cosmonic:agent/tools@0.4.1;
}

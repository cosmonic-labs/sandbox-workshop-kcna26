/// Inference, authorized model access, tools, and durable agent sessions.
package cosmonic:agent@0.4.1;

/// Messages, model handles, options, usage, and inference errors.
@since(version = 0.4.0)
interface inference-types {
  /// UTF-8 JSON. Producers emit valid JSON; consumers parse it defensively.
  type json = string;

  /// An IANA media type, passed through to providers and tools.
  type media-type = string;

  /// A provider-owned handle ready for local or remote inference.
  /// Dropping it releases its reservation; accepted work keeps its dependencies.
  /// Handles retain provider identity across alias changes. Routers own wrapper
  /// handles and forward calls to the provider that created each underlying handle.
  resource model {
    /// The supported operations and limits of this prepared handle.
    describe: async func() -> model-description;
  }

  @since(version = 0.4.0)
  flags supported-operations {
    chat,
    embeddings,
  }

  flags response-formats {
    text,
    json-object,
    json-schema,
  }

  variant attachment-source {
    /// Inline bytes, the form supplied to sandboxed guests.
    bytes(list<u8>),
    /// Fetched by the host under the calling workload's egress policy.
    /// The host checks egress before fetching or forwarding the URL, and
    /// rejects fetched content whose media type differs from the declaration.
    url(string),
    /// An opaque id for content the host stores, issued by the host and
    /// sealed to the session it was issued in. Agents keep it and pass it
    /// through unchanged; the host resolves it to the bytes when it calls a
    /// model. When a stored id exists, agents must not persist the bytes,
    /// in the session or anywhere else. An id from another session, or one
    /// the host no longer holds, is refused before any model is called.
    stored(string),
  }

  /// An attachment with its declared media type and byte source.
  record attachment {
    /// The provider must support this type or report an adaptation.
    media-type: media-type,
    source: attachment-source,
    /// A filename shown to people, such as `report.pdf`. Untrusted text
    /// supplied by whoever made the attachment: render it as text, never
    /// use it as a path, and never infer the media type from it.
    display-name: option<string>,
  }

  /// A tool call's input as the model wrote it.
  @since(version = 0.4.0)
  variant tool-arguments {
    /// A JSON object, for a `json-schema` tool.
    json(json),
    /// The model's raw text, verbatim and never JSON parsed, for a
    /// `grammar` or `text` tool.
    text(string),
  }

  /// A function call requested by the model.
  record tool-call {
    /// Correlates the result. The host supplies a unique id if the provider omits it.
    id: string,
    /// The name advertised in the request's tool list.
    name: string,
    /// The call's input, tagged by the named tool's `input`. Model
    /// generated and untrusted; parse and validate defensively.
    arguments: tool-arguments,
  }

  /// Text or attachments returned by a tool.
  variant tool-output {
    text(string),
    attachment(attachment),
  }

  record tool-result {
    /// Must equal the tool-call.id being answered.
    call-id: string,
    output: list<tool-output>,
    /// The tool ran and failed. Return the failure to the model as a normal result.
    is-error: bool,
  }

  /// A provider block not modeled by this interface. Guests must return it
  /// unmodified. Providers that cannot carry it report a dropped-part adaptation.
  record opaque-block {
    /// The provider's block discriminator.
    kind: string,
    /// The original block as JSON.
    json: json,
  }

  /// Displayable reasoning summary; an empty summary is valid.
  /// Return continuation data unmodified: complete provider blocks in
  /// assistant-content.other, and modeled parts' data in assistant-part.opaque.
  ///
  /// Signed or encrypted reasoning that must be replayed, such as Anthropic
  /// thinking signatures and OpenAI encrypted reasoning items, travels in
  /// opaque. Redacted reasoning, such as Anthropic redacted_thinking, is a
  /// reasoning part with an empty summary and its data in opaque.
  record reasoning {
    summary: list<string>,
  }

  variant assistant-content {
    text(string),
    reasoning(reasoning),
    tool-use(tool-call),
    /// Generated media. Return it unchanged; unsupported providers report an adaptation.
    attachment(attachment),
    /// The model's explanation of why it declined, kept apart from answer
    /// text, such as OpenAI's refusal content part. It is not an answer
    /// and never satisfies a response format. Providers without a refusal
    /// part send it back as text and report part-substituted(text).
    refusal(string),
    other(opaque-block),
  }

  /// A source the provider says supports some of a text part, such as an
  /// Anthropic citation or an OpenAI url_citation annotation. Untrusted
  /// provider output: render it as text and links, never follow it.
  @since(version = 0.4.0)
  record citation {
    /// The source's URL, when it has one.
    url: option<string>,
    /// The source's title, such as a page or document title.
    title: option<string>,
    /// The quoted source text, when the provider returns it.
    cited-text: option<string>,
    /// UTF-8 byte offsets, start inclusive and end exclusive, of the text
    /// this source supports. None means the whole part. Providers convert
    /// character indices, such as OpenAI's, to byte offsets.
    span: option<tuple<u32, u32>>,
  }

  /// An assistant part with continuation data. Providers preserve order where
  /// their wire format allows it; callers must not rely on text/tool interleaving.
  record assistant-part {
    content: assistant-content,
    /// Host-framed continuation data for this part. Return it byte-for-byte;
    /// do not parse, synthesize, or re-encode it. The host checks whether it is
    /// valid for the destination provider and model.
    opaque: option<string>,
    /// Sources the provider attached to a text part, for display; empty for
    /// other parts. Replay needs nothing from it: the provider's own form
    /// travels in `opaque`.
    citations: list<citation>,
  }

  variant user-part {
    text(string),
    attachment(attachment),
  }

  record assistant-message {
    content: list<assistant-part>,
  }

  record user-message {
    content: list<user-part>,
    /// An author label. Tool results correlate through tool-result.call-id.
    name: option<string>,
  }

  /// Conversation turns. Return assistant content and continuation data unchanged.
  variant message {
    system(string),
    user(user-message),
    assistant(assistant-message),
    tool(list<tool-result>),
  }

  /// Whether the model reasons before answering, and on what budget.
  variant thinking-mode {
    /// Explicitly off, as distinct from an absent `thinking`.
    off,
    /// The model chooses whether and how much to reason.
    adaptive,
    /// Maximum reasoning tokens, where the provider supports a token budget.
    budget(u32),
  }

  /// Requested effort. Providers report adaptation when mapping to a coarser scale.
  enum effort {
    minimal,
    low,
    medium,
    high,
    xhigh,
    maximum,
  }

  variant response-format {
    /// Free-form text.
    text,
    /// Any JSON object.
    json-object,
    /// JSON matching this schema. Unenforceable schemas return invalid-options.
    json-schema(json),
  }

  record logit-bias {
    token: u32,
    bias: f32,
  }

  /// The reason generation ended, including provider-specific reasons.
  variant finish-reason {
    /// The model ended its reply.
    stop,
    /// A stop sequence matched.
    stop-sequence,
    /// `max-tokens` was reached.
    max-tokens,
    /// The context window filled up.
    context-length,
    /// A completed turn containing tool calls. Token or context limits take
    /// precedence. Drop incomplete calls and report part-dropped(tool-use);
    /// never dispatch a call with truncated arguments.
    tool-calls,
    /// The model declined to answer, such as Anthropic's refusal stop
    /// reason. Any refusal text is in the message.
    refusal,
    /// A provider safety filter withheld or cut the output, such as
    /// OpenAI's content_filter or Gemini's SAFETY. The message may be
    /// partial or empty.
    content-filter,
    /// The provider paused a long turn, such as Anthropic's pause_turn
    /// during server-side tool use. Append the message unchanged and call
    /// again to let the model continue; it is not a final reply.
    pause-turn,
    /// An unmodeled stop reason, using the provider's name.
    other(string),
  }

  /// Token usage. None means unreported; zero means reported as zero.
  record usage {
    prompt-tokens: option<u32>,
    /// Prompt tokens reused from the provider cache.
    cached-prompt-tokens: option<u32>,
    /// Prompt tokens written into the provider cache.
    cache-write-tokens: option<u32>,
    completion-tokens: option<u32>,
    /// Completion tokens spent on reasoning.
    reasoning-tokens: option<u32>,
  }

  /// Incremental tool-call fields. arguments-delta is a fragment of the
  /// call's input as the model writes it: JSON text for a `json-schema`
  /// tool, raw text for a `grammar` or `text` tool. The assembled call carries it as
  /// `tool-arguments`.
  record tool-call-delta {
    /// Zero-based call index in opening order. Join interleaved fragments by this id.
    index: u32,
    /// Present on the frame that opens the call, absent on continuations.
    id: option<string>,
    /// Present on the frame that opens the call, absent on continuations.
    name: option<string>,
    arguments-delta: string,
  }

  /// Content in a streamed frame.
  variant chunk-delta {
    text(string),
    /// Reasoning summary text, separate from the answer.
    reasoning-text(string),
    tool-call(tool-call-delta),
    /// A complete part, including terminal continuation data that cannot stream.
    part(assistant-part),
  }

  /// Location in the caller's original request, before provider transformations.
  record part-ref {
    /// Index into the messages the caller supplied.
    message-index: u32,
    /// Part index. Zero for system text; tool turns index the tool-result list.
    part-index: u32,
    /// Index in tool-result.output when the change is within a tool result.
    output-index: option<u32>,
  }

  /// Request metadata. Providers may ignore fields they cannot use.
  record request-meta {
    /// W3C traceparent for linking caller and provider traces.
    trace-parent: option<string>,
    /// Give up after this many milliseconds, counted from the call.
    deadline-ms: option<u32>,
    /// Provider prompt-cache key. The host must scope it to the calling workload.
    cache-key: option<string>,
    /// Cache the prompt prefix ending at each of these parts, as Anthropic's
    /// cache_control breakpoints do. Tools and system text come first in the
    /// prefix, so a breakpoint on the system text also covers the tools;
    /// there is no breakpoint after the tools alone. Providers that cache
    /// automatically, or cannot place this many breakpoints, use what they
    /// can.
    cache-points: list<part-ref>,
    /// Key-value labels for metering and logs. Not sent to a provider.
    labels: list<tuple<string, string>>,
  }

  enum part-kind {
    text,
    reasoning,
    tool-use,
    tool-result,
    attachment,
    opaque,
  }

  /// A request-level knob, for reporting that one did not survive.
  enum request-option {
    tools,
    tool-choice,
    parallel-tool-calls,
    /// `grammar` or `text` tool input, or a grammar syntax. In
    /// `supported-options` it advertises native freeform tools.
    freeform-tools,
    response-format,
    thinking,
    effort,
    max-tokens,
    temperature,
    top-k,
    top-p,
    min-p,
    frequency-penalty,
    presence-penalty,
    repeat-penalty,
    penalty-last-n,
    logit-bias,
    seed,
    stop,
  }

  /// Support and limits of this provider/model pair. Optional fields may be unknown.
  /// Unsupported values follow on-unrepresentable; never silently drop them.
  record model-description {
    model: option<string>,
    supported-operations: supported-operations,
    context-length: option<u32>,
    max-output-tokens: option<u32>,
    tools: option<bool>,
    reasoning: option<bool>,
    /// Non-text input media types the model takes in user and tool content,
    /// such as image/png, image/*, application/pdf, text/csv, text/* or
    /// audio/wav. A type/* entry covers every subtype. None means unknown;
    /// some(empty) means text-only input.
    accepts: option<list<media-type>>,
    response-formats: option<response-formats>,
    /// None means unknown; some(empty) means no optional knobs.
    /// Presence advertises support, not acceptance of every possible value.
    supported-options: option<list<request-option>>,
  }

  /// A change needed to represent a request for this provider.
  variant adaptation-kind {
    /// Replaced with supported content.
    part-substituted(part-kind),
    /// Removed because the provider cannot carry it.
    part-dropped(part-kind),
    /// The backend has no equivalent, so the knob was not sent.
    option-ignored(request-option),
    /// Narrowed to values the provider supports.
    option-clamped(request-option),
  }

  /// A reported change to the request.
  record adaptation {
    /// Absent for whole-request conditions, which have no part to point at.
    location: option<part-ref>,
    kind: adaptation-kind,
    /// Human-readable, for a log or a UI. Not for branching on.
    detail: string,
  }

  record completion {
    finish-reason: finish-reason,
    usage: usage,
    /// The assembled assistant turn to append to conversation history unchanged.
    message: assistant-message,
    /// All changes made to represent the request; empty means no changes.
    adaptations: list<adaptation>,
    /// The concrete model that served the request after alias resolution.
    model: string,
  }

  /// A streamed frame. Finish reason, usage, and adaptations are optional hints;
  /// completion is authoritative. A reply may contain no frames.
  record chunk {
    delta: chunk-delta,
    adaptations: list<adaptation>,
    finish-reason: option<finish-reason>,
    usage: option<usage>,
  }

  /// Policy for requests that cannot be represented unchanged.
  enum unrepresentable-policy {
    /// Adapt the request and report each change.
    adapt,
    /// Refuse, and say what could not be represented.
    refuse,
  }

  /// Context overflow. Token counts are optional when the provider omits them.
  record context-overflow {
    prompt-tokens: option<u32>,
    context-length: option<u32>,
    /// What the backend said, for a log or a UI.
    detail: string,
  }

  /// An account or spending limit requiring operator action. Classify by the
  /// provider's error, not HTTP status; quota failures and throttling may both be 429.
  record quota {
    /// Remediation URL supplied by the provider, if any.
    top-up-url: option<string>,
    /// What the backend said, verbatim.
    detail: string,
  }

  /// How long the backend expects the caller to wait.
  record rate-limit {
    /// Normalized, capped retry delay. None means no usable hint, not immediate retry.
    retry-after-seconds: option<u32>,
    /// Human-readable, for a log or a UI. Not for branching on.
    detail: string,
  }

  /// A size the host refuses to exceed.
  record size-limit {
    /// The limit, in bytes.
    limit: u64,
    /// Human-readable scope, such as request, attachment, or alias.
    what: string,
  }

  /// Failure before chat acceptance; later failures use generation-error.
  variant request-error {
    /// Processing was cancelled before acceptance.
    cancelled,
    /// The provider's execution deadline elapsed before acceptance.
    timed-out,
    /// The prompt leaves no room in the context window for a reply.
    context-length-exceeded(context-overflow),
    /// The options were out of range or unsupported.
    invalid-options(string),
    /// The message stream was incomplete or its writer reported failure.
    messages-incomplete(string),
    /// The request needs adaptation but on-unrepresentable is refuse.
    unrepresentable(list<adaptation>),
    /// The host's provider credentials were rejected; requires operator action.
    not-authenticated(string),
    /// Throttled. Back off before retrying.
    rate-limited(rate-limit),
    /// Account quota exhausted; retrying or waiting cannot resolve it.
    quota-exhausted(quota),
    /// A transient provider or connection failure; retry may succeed.
    temporarily-unavailable(rate-limit),
    /// Request or part exceeds the host limit; refused before provider dispatch.
    too-large(size-limit),
    /// Unclassified failure, treated as permanent.
    other(string),
  }

  /// Failure after chat acceptance, including before the first reply chunk.
  /// Only named transient failures imply a retry may succeed.
  variant generation-error {
    /// Generation was cancelled before a terminal outcome was recorded.
    cancelled,
    /// The provider's execution deadline elapsed.
    timed-out,
    /// Throttled partway through.
    rate-limited(rate-limit),
    /// The backend or the connection to it failed partway through.
    temporarily-unavailable(rate-limit),
    /// The context window filled before the model finished.
    context-length-exceeded(context-overflow),
    other(string),
  }

  @since(version = 0.4.0)
  enum grammar-syntax {
    /// A Lark grammar, as OpenAI custom tools take.
    lark,
    /// A regular expression the whole input matches.
    regex,
  }

  /// A grammar the model's freeform input should match.
  @since(version = 0.4.0)
  record grammar {
    syntax: grammar-syntax,
    definition: string,
  }

  /// What a tool takes as input, and so how the model writes a call's
  /// `arguments`. A tool whose input is `grammar` or `text` is a freeform
  /// tool: the model writes text, and the call carries it as
  /// `tool-arguments.text`.
  ///
  /// A provider without native freeform tools either refuses or, under
  /// `adapt`, offers the tool as a JSON schema with one string property,
  /// unwraps the model's string back into `text` arguments, and reports
  /// `option-ignored(freeform-tools)` naming the tool. Callers always see
  /// text arguments for a freeform tool. Agents can check
  /// `supported-options` for `freeform-tools` before relying on the
  /// grammar.
  ///
  /// The grammar steers the model; it is not validation. Freeform input is
  /// untrusted text like any tool input, and the tool must validate it.
  @since(version = 0.4.0)
  variant tool-input {
    /// A JSON object matching this JSON Schema. The common case.
    json-schema(json),
    /// Text the grammar constrains, such as a patch format.
    grammar(grammar),
    /// Plain text, unconstrained.
    text,
  }

  /// A tool definition offered to the model.
  record tool-def {
    name: string,
    /// Display label; name is the model's selection key.
    title: option<string>,
    description: string,
    /// What the model writes as the call's input: a JSON object matching
    /// a schema, text a grammar constrains, or plain text.
    input: tool-input,
    /// Optional JSON Schema for the result.
    output-schema: option<json>,
  }

  variant tool-choice {
    /// The model decides. The default when unset.
    auto,
    /// Never call a tool.
    none,
    /// Call some tool.
    required,
    /// Call this specific tool.
    specific(string),
  }

  /// How to generate a reply. Unset fields take the backend's defaults.
  record chat-options {
    /// Generated-token limit. Zero is invalid-options.
    max-tokens: option<u32>,
    /// Higher is more random; `0` always picks the most likely token.
    temperature: option<f32>,
    /// Keep only the `top-k` most likely tokens; `0` keeps them all.
    top-k: option<u32>,
    /// Keep tokens covering this probability mass; 1 keeps them all.
    top-p: option<f32>,
    /// Drop tokens below min-p times the largest probability; 0 keeps them all.
    min-p: option<f32>,
    /// Lowers the odds of a token once per time it already appeared.
    frequency-penalty: option<f32>,
    /// Lowers the odds of any token that already appeared.
    presence-penalty: option<f32>,
    /// Divides the odds of tokens that already appeared; `1` is off.
    repeat-penalty: option<f32>,
    /// Recent tokens considered by penalties, capped at the context length.
    penalty-last-n: option<u32>,
    /// Biases provider-specific token ids; a large negative bias bans a token.
    logit-bias: list<logit-bias>,
    /// Requests repeatable sampling. Providers report unsupported seeds or conversions.
    seed: option<u64>,
    /// Stop before emitting a matched sequence; exclude it from the reply.
    stop: list<string>,
    /// The shape the reply must take.
    response-format: response-format,
    /// Tools offered to the model. Providers render definitions and parse calls.
    tools: list<tool-def>,
    tool-choice: option<tool-choice>,
    /// Whether the model may request more than one tool call in a reply.
    /// None uses the provider default; false asks for at most one.
    parallel-tool-calls: option<bool>,
    /// Reasoning mode. None uses the provider default; off explicitly disables it.
    /// Unsupported modes follow on-unrepresentable.
    thinking: option<thinking-mode>,
    effort: option<effort>,
    /// About the request rather than the reply: tracing, deadlines, caching.
    meta: request-meta,
    /// Refuse or report changes needed to represent this request. Unavoidable
    /// changes, such as dropping invalid continuation data, are always reported.
    on-unrepresentable: unrepresentable-policy,
  }
}

/// Streaming inference with a prepared model.
@since(version = 0.3.0)
interface chat {
  use inference-types.{model, message, chat-options, chunk, completion, request-error, generation-error};

  /// Reply chunks followed by the assembled completion or generation error.
  type reply = tuple<stream<chunk>, future<result<completion, generation-error>>>;

  /// Write messages while this call is pending; streams do not buffer. Close
  /// the stream, then resolve messages-done to ok for a complete conversation.
  ///
  /// Acceptance reads all messages and validates the request. Failures before
  /// acceptance are request-error; failures afterward arrive on the outcome future.
  /// A provider may wait for upstream acceptance before returning.
  ///
  /// Text deltas contain whole UTF-8 characters. Drain chunks before awaiting
  /// the outcome. Dropping chunks requests cancellation of unfinished generation.
  /// The first terminal outcome wins; a later cancellation does not replace it.
  /// Cancellation returns generation-error.cancelled; deadline expiry returns
  /// generation-error.timed-out. Cancellation is cooperative, not immediate.
  /// Abandoning the pending chat call may return no WIT result.
  chat: async func(model: borrow<model>, messages: stream<message>, messages-done: future<result<_, string>>, options: chat-options) -> result<reply, request-error>;
}

/// Text embeddings with a prepared model.
@since(version = 0.3.0)
interface embeddings {
  use inference-types.{model};

  record embedded {
    /// One vector per input, in input order. Scaling is provider-specific.
    embeddings: list<list<f32>>,
    /// Tokens across all inputs.
    prompt-tokens: u32,
  }

  record input-overflow {
    /// Which input does not fit.
    index: u32,
    tokens: u32,
    context-length: u32,
  }

  variant embed-error {
    /// An input has more tokens than the model takes at once.
    input-too-long(input-overflow),
    /// An input is empty.
    empty-input(u32),
    /// The model cannot produce embeddings.
    unsupported(string),
    /// Anything else.
    other(string),
  }

  embed: async func(model: borrow<model>, inputs: list<string>) -> result<embedded, embed-error>;
}

/// Trusted catalog and preparation controls for local or remote inference.
/// Agents acquire authorized handles through models instead.
@since(version = 0.3.0)
interface model-admin {
  use inference-types.{model, model-description};

  variant prepare-error {
    /// Capacity is reserved or the model is draining; the caller may retry.
    temporarily-unavailable(string),
    /// Preparation failed over the network.
    network-error(string),
    /// Preparation failed while accessing local model data.
    file-system-error(string),
    /// Anything else.
    other(string),
  }

  record prepare-options {
    /// Requested prompt-plus-reply context window. None uses the provider default;
    /// the provider caps it to the model's supported window.
    context-length: option<u32>,
  }

  /// How far a phase that moves bytes has got.
  record byte-progress {
    /// Bytes done so far in this phase.
    completed: u64,
    /// Bytes this phase has in total, when known.
    total: option<u64>,
  }

  /// Preparation progress. Initializing has no byte count and may include
  /// opening a remote connection. Providers only emit phases they perform.
  variant prepare-progress {
    reading-cache(byte-progress),
    downloading(byte-progress),
    writing-cache(byte-progress),
    initializing,
  }

  /// A model the provider can prepare for inference.
  resource model-info {
    name: async func() -> string;
    description: async func() -> string;
    describe: async func() -> model-description;
    /// Acquire a handle, sharing resident weights or a connection when possible.
    /// Dropping the handle releases its reservation, not another caller's work.
    /// Progress is coalesced and never blocks preparation; dropping it does not cancel work.
    /// The outcome resolves when ready; pending progress may drain afterward.
    /// Remote providers may return an empty stream.
    prepare: async func(options: prepare-options) -> tuple<stream<prepare-progress>, future<result<model, prepare-error>>>;
  }

  get-available-models: async func() -> list<model-info>;
}

/// Optional, trusted controls for providers that manage local model residency.
/// Hosts allow this interface separately from inference and agent aliases.
@since(version = 0.3.0)
interface model-residency {
  use model-admin.{prepare-progress, prepare-error};

  enum residency-state {
    unloaded,
    preparing,
    ready,
    draining,
  }

  record residency-status {
    state: residency-state,
    /// Outstanding inference handles and accepted work.
    handles: u32,
    pins: u32,
  }

  variant residency-error {
    unknown-model(string),
    unsupported(string),
    preparation(prepare-error),
    other(string),
  }

  /// Keeps a model resident. Dropping this reservation releases only its pin.
  resource reservation;

  /// Reports residency without preparing the model or reading its weights.
  status: async func(name: string) -> result<residency-status, residency-error>;

  /// Prepare and pin a model. Multiple reservations hold independent pins.
  /// Dropping progress does not cancel preparation; dropping the result releases its pin.
  pin: async func(name: string) -> tuple<stream<prepare-progress>, future<result<reservation, residency-error>>>;

  /// Reject new preparation until existing handles, work, and pins finish.
  /// The outcome resolves after resident resources are released. Dropping it
  /// does not cancel draining. Later preparation may load the model again.
  /// Downloaded weights are retained.
  unload: async func(name: string) -> result<future<result<_, residency-error>>, residency-error>;
}

/// Workload-scoped aliases resolved by the host to an inference provider.
/// Trusted catalog and residency controls are separate.
@since(version = 0.3.0)
interface models {
  use inference-types.{model, model-description};

  variant open-error {
    unknown-alias(string),
    denied(string),
    unavailable(string),
    /// The alias exceeds the host's byte limit.
    too-large(u64),
    other(string),
  }

  /// Returns a handle served by the same provider as chat and embeddings.
  /// A router must forward its own handles to that provider's resources.
  /// Existing handles retain their provider when an alias changes.
  open: async func(alias: string) -> result<model, open-error>;

  /// Resolves the alias afresh and reports what the host knows.
  /// The same workload access checks as open apply.
  describe: async func(alias: string) -> result<model-description, open-error>;
}

/// Types for handing an agent runs: how to do one, what it streams while it
/// works, and how it ends. Unstable: a consumer enables the `agent-run`
/// feature to see these items.
///
/// Function-less: importing it gives no permission. The power to start a run
/// lives in `run`, which an agent exports.
///
/// A run is one unit of work: a message in, the agent's loop of model calls
/// (steps) and tool calls, and a final reply out. In a chat UI one run is one
/// turn of the conversation. "Step" means one message the agent adds
/// to the conversation: a model reply, the results of the tools it called,
/// or an error it records.
///
/// What the agent sends is the agent's own text. A driver treats every
/// string here as untrusted: it renders text as text, and never parses a
/// detail string to decide what to do.
@unstable(feature = agent-run)
interface run-types {
  @unstable(feature = agent-run)
  use wasi:clocks/types@0.3.0.{duration};
  @unstable(feature = agent-run)
  use inference-types.{json, attachment, opaque-block, assistant-message, user-message, tool-result, usage, request-error, generation-error, effort, citation};

  /// How to do one run. Construction is lenient; `run` validates and
  /// returns `invalid-input`.
  @unstable(feature = agent-run)
  record run-options {
    /// Names this run, chosen by the driver. Unique per session, not per
    /// workload: two sessions may use the same id space. A driver uses
    /// a UUID, or the id of the event that started it (a message id, a
    /// ticket event id), so a redelivered event is recognized. The agent
    /// records it on the run's journal entries and uses it in the commit id
    /// of the commit that opens the run, so the same id again returns
    /// `duplicate` instead of running twice.
    run-id: string,
    /// Instructions for this run, ahead of the agent's own. Sent on every
    /// run, so the agent holds no instructions its driver did not give it.
    instructions: option<string>,
    /// JSON Schema the final reply must satisfy. The agent asks its model
    /// to answer in it and returns the answer as `run-outcome.structured`;
    /// a driver that needs it checks it again. A refusal or filtered reply
    /// carries no structured answer (`finish.refusal`,
    /// `finish.content-filter`).
    schema: option<json>,
    /// Model calls the agent may make in this run, counting a call made
    /// again after `finish-reason.pause-turn`, whose paused reply is never
    /// the final one. The agent stops and finishes with `max-steps` when
    /// it is reached. Advisory: the agent counts its own steps, so a driver
    /// enforces it only where it meters the agent's model calls itself.
    max-steps: option<u32>,
    /// Tokens the agent may spend in this run, across all its model calls:
    /// the sum of `usage.prompt-tokens` and `usage.completion-tokens`. Not
    /// `chat-options.max-tokens`, which bounds what one call generates. The
    /// agent checks it after each model call and finishes with
    /// `max-total-tokens` once it is spent, so the call that crosses it
    /// may overshoot. Advisory, like `max-steps`.
    max-total-tokens: option<u64>,
    /// Wall-clock time for this run, counted from acceptance: from when
    /// `run` returns ok, so time spent reading the session before the run
    /// is accepted does not count. Time spent waiting on a person (a held
    /// tool call, a question) does count. The agent stops starting model and
    /// tool calls once it passes, and finishes with `max-duration` and
    /// what it has. A driver keeps its own deadline a little past this
    /// one and cancels at it.
    max-duration: option<duration>,
    /// Reasoning effort the person chose for this run, such as a
    /// low-effort quick question or a high-effort refactor. The agent
    /// passes it as `chat-options.effort` on its model calls; none leaves
    /// the agent's own choice. Advisory: the provider may map it to a
    /// coarser scale and report the adaptation.
    effort: option<effort>,
    /// W3C traceparent of the driver's trace, for the agent to pass on in
    /// `request-meta.trace-parent` so its model calls join that trace.
    trace-parent: option<string>,
  }

  /// What a step holds.
  @unstable(feature = agent-run)
  variant step-content {
    /// A model reply: text, reasoning summary, tool calls and
    /// attachments, as the model call returned it. The agent may leave out
    /// continuation data (`assistant-part.opaque` and `other` blocks); a
    /// driver ignores it.
    assistant(assistant-message),
    /// The results of the tool calls in the assistant step before it.
    tool(list<tool-result>),
    /// Reserved: a message from the person that the agent took in during
    /// the run, such as a steering message, in the place it entered the
    /// conversation. Never the message that started the run, which the
    /// driver already has. No interface delivers such messages yet (a
    /// future opt-in import will), so an agent does not send this case
    /// today. A driver renders it as the person's own message, in the
    /// conversation where it appears, attributed to the person and never
    /// to the agent.
    user(user-message),
    /// An error the agent recorded in the conversation, for a person to
    /// read. Diagnostic text, not for branching on. A run may continue
    /// after one, for example when listing tools failed.
    error(string),
    /// A step kind not captured above, described by the string. Safe to skip.
    other(string),
  }

  /// One whole message the agent added to the conversation.
  @unstable(feature = agent-run)
  record step {
    /// What the message holds.
    content: step-content,
    /// The `seq` of the `agent.step.v1` journal entry recording this
    /// message, when the agent committed it before sending this step. A
    /// driver that also reads the journal uses it to match the two.
    seq: option<u64>,
  }

  /// Counters for one run. Reported by the agent, so only as honest as it
  /// is; a host that meters model calls has its own record.
  @unstable(feature = agent-run)
  record run-counts {
    /// Model calls made.
    steps: u32,
    /// Tool calls made.
    tool-calls: u32,
    /// Token usage summed over the run's model calls. None in a field
    /// means unreported; a sum past the u32 maximum stays at it.
    usage: usage,
  }

  /// An inclusive range of journal entries, by `seq`.
  @unstable(feature = agent-run)
  record seq-range {
    /// `seq` of the first entry in the range.
    start: u64,
    /// `seq` of the last entry in the range, inclusive.
    end: u64,
  }

  /// Why the agent summarized. Mirrors `trigger` in the `agent.compaction.v1`
  /// journal entry, as its lowercase name.
  @unstable(feature = agent-run)
  enum compaction-trigger {
    /// The context passed the agent's own threshold before a model call.
    threshold,
    /// A model call was refused because the context was too long, so the
    /// agent summarized before trying again.
    overflow,
    /// The driver asked, through `compact`.
    requested,
  }

  /// The agent replaced older context with a summary so its next model call
  /// fits. Mirrors the `agent.compaction.v1` journal entry (`session`), whose
  /// JSON fields carry the same names in camelCase. The full summary lives
  /// only in that entry, not here; it is model output, so a driver treats it
  /// as untrusted text and never as system or person text. The entries it
  /// covers stay in the journal.
  @unstable(feature = agent-run)
  record compaction-info {
    /// The journal entries the summary replaces in the agent's context.
    through: seq-range,
    /// Why the agent summarized.
    trigger: compaction-trigger,
    /// Recent messages carried over verbatim after the summary.
    kept: u32,
    /// Estimated context tokens before compaction; none when unknown.
    tokens-before: option<u64>,
    /// Estimated context tokens after compaction; none when unknown.
    tokens-after: option<u64>,
    /// The `seq` of the `agent.compaction.v1` entry, when the agent
    /// committed it before sending this event, as `step.seq` does.
    seq: option<u64>,
  }

  /// Where a plan entry stands.
  @unstable(feature = agent-run)
  enum plan-status {
    pending,
    in-progress,
    completed,
  }

  /// One item of the agent's working plan.
  @unstable(feature = agent-run)
  record plan-entry {
    /// What the item is, in the agent's words.
    content: string,
    status: plan-status,
  }

  /// What a run streams while it works. The person's own message is never
  /// sent back: the driver already has it.
  @unstable(feature = agent-run)
  variant run-event {
    /// Reply text as the model produces it, in whole UTF-8 characters.
    /// A driver shows it as a reply in progress until the next `step`,
    /// which carries the whole message and replaces it.
    text-delta(string),
    /// Reasoning summary text as the model produces it, kept apart from
    /// the reply. Replaced by the next `step` the same way.
    reasoning-delta(string),
    /// A whole message, in conversation order.
    step(step),
    /// Cumulative counters for this run so far, sent after each model
    /// call.
    counts(run-counts),
    /// Older context was summarized. Sent after the agent commits
    /// `agent.compaction.v1`, so a driver can mark the point in the
    /// conversation; the summary itself is read from the journal.
    compacted(compaction-info),
    /// The agent's whole current plan, replacing any earlier one, as
    /// Claude Code's todo list or Codex's update_plan show it. Agent text
    /// for display: a driver never treats it as progress it can verify or
    /// as a commitment. An agent that keeps no plan never sends it.
    /// Sent after the agent commits `agent.plan.v1` with the same
    /// entries, so a driver that reloads reads the current plan from the
    /// journal.
    plan(list<plan-entry>),
    /// An event not captured above, described by the string. Safe to ignore.
    other(string),
  }

  /// Reply text with the sources the provider attached to it, as
  /// `assistant-part.citations` carried them. Citations are untrusted
  /// provider output for display: render them as text and links on the
  /// text they support, never follow them.
  @unstable(feature = agent-run)
  record cited-reply-text {
    text: string,
    /// Never empty: text without citations is `reply-part.text`.
    citations: list<citation>,
  }

  /// A final reply part: the display projection of one assistant part. No
  /// tool use, reasoning, or continuation data. Every `assistant-content`
  /// case maps to one case here, so a driver that reads only the outcome
  /// loses no display content: `text` with no citations to `text`, `text`
  /// with citations to `cited-text`, `attachment` to `attachment`, `refusal`
  /// to `refusal`, `other` to `opaque`; tool use and reasoning are dropped.
  @unstable(feature = agent-run)
  variant reply-part {
    /// Reply text that carries no citations.
    text(string),
    /// Reply text with the sources that support it.
    cited-text(cited-reply-text),
    /// The model's explanation of why it declined, from
    /// `assistant-content.refusal`. Show it as the model's text, never as
    /// an answer: it never satisfies `run-options.schema`.
    refusal(string),
    /// An attachment the agent produced.
    attachment(attachment),
    /// A provider-specific block passed through unchanged.
    opaque(opaque-block),
    /// A part kind not captured above, described by the string. Treat as
    /// unknown.
    other(string),
  }

  /// Why a run ended with an outcome.
  ///
  /// `refusal` and `content-filter` are defined by the model call that
  /// produced the run's last assistant step, never by whichever call came
  /// last: a summary call that ends refusal or content-filter writes no
  /// step and no summary (the run goes on with the context it had), so it
  /// never makes a run finish `refusal` or `content-filter`.
  ///
  /// Precedence. When that call ended refusal or content-filter, the run
  /// finishes `refusal` or `content-filter`, even if the call also reached
  /// a limit, and the agent does not report `input-required` from a reply
  /// it was refused. A limit (`max-steps`, `max-total-tokens`,
  /// `max-duration`) is the finish only when it stopped the run before a
  /// call the run would otherwise have made, such as the tool calls a
  /// reply asked for, and `input-required` only when the last assistant
  /// step is the agent's own question.
  @unstable(feature = agent-run)
  variant finish {
    /// The agent ended its reply.
    done,
    /// The agent stopped because it needs something only a person can
    /// give (an answer, a choice, a decision) and no one could answer
    /// during the run: the host offered no way to ask, or the person did
    /// not answer in time. `reply` says what is needed, in the agent's own
    /// words; a driver shows it as the agent's text, never as host UI.
    /// The answer starts the next run, as its message, and the journal
    /// tells the agent where it left off. An agent uses it only when it
    /// cannot go on without the answer; one that can go on with a stated
    /// assumption does so and finishes `done`. Agent-reported, so a driver
    /// uses it to route the outcome (to a person, a ticket, an A2A
    /// `input-required` task) and never to allow anything.
    input-required,
    /// `run-options.max-steps` was reached.
    max-steps,
    /// `run-options.max-total-tokens` was spent.
    max-total-tokens,
    /// `run-options.max-duration` passed.
    max-duration,
    /// The model declined to answer: the call that produced the run's last
    /// assistant step ended with `finish-reason.refusal`, or that step's
    /// reply carries a `refusal` part.
    /// `reply` holds whatever the model said, usually a `refusal` part; a
    /// provider that sent the refusal as text leaves it as `text`. Not an
    /// error and not an answer: `structured` is none, and a run with a
    /// schema finishes `refusal` rather than failing `output-rejected`.
    refusal,
    /// A provider safety filter withheld or cut the output of the call
    /// that produced the run's last assistant step
    /// (`finish-reason.content-filter`). `reply` holds what
    /// survived, which may be partial or empty, and `structured` is none,
    /// as for `refusal`. The agent does not retry the call to get around
    /// the filter.
    content-filter,
    /// A reason not captured above. Diagnostic detail; never parse it.
    other(string),
  }

  /// The model that answered, for display. A host that meters model calls
  /// has the authoritative record.
  @unstable(feature = agent-run)
  record served-model {
    /// The alias the agent opened, as `models.open` took it.
    alias: string,
    /// The concrete model that served the run's last model call, as
    /// `completion.model` reported it.
    model: string,
  }

  /// The result of a run that ended with a reply.
  @unstable(feature = agent-run)
  record run-outcome {
    /// Final reply parts, in order: the reply of the run's last assistant
    /// step, projected as `reply-part` describes, without its tool calls.
    reply: list<reply-part>,
    /// The reply as JSON satisfying `run-options.schema`; present only
    /// when one was set. Always none when `finish` is `refusal` or
    /// `content-filter`, which a schema never turns into
    /// `output-rejected`.
    structured: option<json>,
    /// What the run cost.
    counts: run-counts,
    /// Why the run ended.
    finish: finish,
    /// The model that answered, when the run made a model call.
    model: option<served-model>,
  }

  /// Why a run did not start. In every case nothing ran and nothing new
  /// was written to the session.
  @unstable(feature = agent-run)
  variant start-error {
    /// A run is already in progress in this session. One run at a time.
    busy,
    /// A run with this `run-id` already started in this session. Its
    /// outcome is in the journal, not here.
    duplicate,
    /// The message or options cannot be taken, for example an attachment
    /// the agent does not accept, an empty message, or a schema it cannot
    /// follow. A different message may succeed.
    invalid-input(string),
    /// The run could not be accepted now, for example because the session
    /// could not be read. Retry may succeed.
    unavailable(string),
    /// A failure not captured above. Treat as permanent. Diagnostic
    /// detail; never parse it.
    other(string),
  }

  /// Why a run failed after it started. The person's message and every
  /// step sent before the failure are in the journal; effects of model and
  /// tool calls made before the failure are not rolled back. Detail strings
  /// are diagnostic only.
  @unstable(feature = agent-run)
  variant run-error {
    /// The driver dropped the events stream. Cancellation is cooperative:
    /// the agent stopped its model and tool calls first.
    cancelled,
    /// `models.open` refused the agent's alias: unknown, denied, or
    /// unavailable.
    no-model(string),
    /// A model call was refused before it was accepted. The case says
    /// whether waiting, the operator, or a smaller request can fix it.
    model-refused(request-error),
    /// A model call failed after it was accepted.
    model-failed(generation-error),
    /// The session refused a write the run needed (too large, or
    /// unavailable), so the agent stopped rather than act without a
    /// record.
    not-recorded(string),
    /// Another writer changed the session during the run, so the agent
    /// stopped before its next model or tool call.
    superseded,
    /// The reply did not satisfy `run-options.schema`. Never used for a
    /// refusal or a filtered reply: those finish `refusal` or
    /// `content-filter`.
    output-rejected(string),
    /// The agent failed for a reason it did not classify.
    failed(string),
    /// A failure not captured above. Treat as permanent. Diagnostic
    /// detail; never parse it.
    other(string),
  }

  /// A run that has started: events, then the outcome. The stream closes
  /// before the outcome resolves; a closed stream alone does not mean
  /// success. Drain events before awaiting the outcome: the agent may wait
  /// on a slow reader, as `chat` does. Dropping the stream requests
  /// cancellation, so a driver that wants only the outcome still reads
  /// and discards the events. An outcome already recorded wins the race,
  /// so a cancelled run may still resolve to its outcome.
  @unstable(feature = agent-run)
  type started-run = tuple<stream<run-event>, future<result<run-outcome, run-error>>>;
}

/// Summarize older context now, at the driver's request, between runs.
/// Exported by an agent that can compact on request; a driver that
/// finds no `compact` export leaves compaction to the agent. Unstable: a
/// consumer enables the `agent-run` feature to see it.
///
/// The same lock and cancellation rules as `run`: one call at a time with
/// any run in the session, `busy` while one is in progress, and dropping the
/// events stream requests cancellation.
///
/// Journal. A compaction is its own operation kind, with its own entries:
/// - Acceptance. Before its first model call, the agent commits
///   `agent.compact.v1` (`compact`: the call's `run-id`, and `focus` when
///   given), using `compact:<run-id>` as that commit's `commit-id`. `compact`
///   resolves only after this commit, as `run` does after `agent.run.v1`.
/// - The summary call sits between `agent.op.v1` and `agent.op-result.v1`,
///   as every model call does.
/// - Terminal record. Every accepted compaction ends with at most one
///   `agent.compact-result.v1` (`compact`, `outcome`: done, failed or
///   cancelled, with `finish` or the error case, and `compacted`: whether it
///   wrote a summary). None means the compaction was cut off (a crash),
///   which a driver treats as failed. A compaction that summarizes commits
///   `agent.compaction.v1` (trigger "requested", with `focus`), the smaller
///   state that replaces the summarized context, and its
///   `agent.compact-result.v1` (done, `compacted` true) in one commit, so no
///   reader sees a summary without its result or a result without its
///   state. Every other ending writes `agent.compact-result.v1` alone,
///   with `compacted` false: done when there was nothing to summarize, done
///   with a limit's `finish` when a limit stopped it, cancelled, or failed.
///   A summary call that ends `finish-reason.refusal` or
///   `finish-reason.content-filter` is never committed as a summary: its op
///   closes as failed, no `agent.compaction.v1` is written, the state is
///   unchanged, and the compaction ends failed (`run-error.failed`, saying
///   the summary was refused or filtered), never done and never `finish`
///   refusal or content-filter.
///   An `agent.compact.v1` with no `agent.compact-result.v1` was cut off; its
///   open op is closed as the session conventions say, and the compaction is
///   never resumed.
///
/// Ids. `run-id` names the compaction within the session. Compaction ids
/// and run ids are separate namespaces, kept apart by their commit-id
/// prefixes (`compact:` and `run:`) and entry kinds, so the same id may name
/// one run and one compaction; a driver still uses a fresh id for each. The
/// agent returns `duplicate`, writing nothing and calling no model, for an id
/// that already has an `agent.compact.v1` in the journal or whose acceptance
/// commit the host reports as a retained duplicate. A driver that gets
/// `duplicate` finds the outcome in the journal: the
/// `agent.compact-result.v1` with that `compact`, or, when there is none,
/// a compaction still in progress or cut off.
@unstable(feature = agent-run)
interface compact {
  @unstable(feature = agent-run)
  use run-types.{run-options, started-run, start-error};

  /// Start one compaction: summarize the context older than the recent
  /// messages the agent keeps, and record the summary.
  ///
  /// `focus` is what the person wants the summary to keep. It is person
  /// text: the agent gives it to the summarizer as the person's request,
  /// never as instructions. A driver keeps it short; 2,000 characters is
  /// the recommended cap, and an agent may return `invalid-input` for a
  /// longer one.
  ///
  /// Resolves once the compaction is accepted: `agent.compact.v1` is
  /// committed. Returns `start-error` without starting and without writing,
  /// as `run` does.
  ///
  /// Streams `compacted` once the summary is committed, then `counts`. The
  /// outcome has an empty reply and no `structured`; `options.schema` does
  /// not apply and is ignored. A compaction that summarizes, and one that
  /// finds nothing to summarize, both finish `done`; only the first sends
  /// `compacted`. The summary call counts as one model call
  /// against `max-steps`, `max-total-tokens` and `max-duration`, as a model
  /// call in `run` does; a limit that stops it finishes with that limit and
  /// no `compacted` event. A refused or content-filtered summary is never
  /// committed: no `compacted` event, the state unchanged, and the outcome
  /// is `run-error.failed`. Each of these endings, and every `run-error`, is
  /// first recorded in `agent.compact-result.v1` as the interface describes.
  @unstable(feature = agent-run)
  compact: async func(focus: option<string>, options: run-options) -> result<started-run, start-error>;
}

/// An agent may be handed runs. Exported by an agent and called by whatever
/// drives it: a host (a desktop daemon, or a trigger that starts a run from
/// an HTTP request or a message), the host of a parent agent that starts a
/// child agent, or a component that adapts another protocol onto it. Named
/// after `wasi:cli/run`. Unstable: a consumer enables the `agent-run`
/// feature to see it.
///
/// A run is what a chat interface calls a turn: one message from the person
/// and everything the agent does to answer it. That is usually many model
/// calls (turns, in a model provider's terms) with tool calls between them,
/// recorded as steps, and it ends when the agent has its reply or stops.
///
/// The agent needs no ingress: nothing but its driver can reach it. The
/// session it works in is not named here. It is the agent's
/// `cosmonic:agent/session` import. The host chooses the session a run works
/// in and binds it to the caller; a run never names one, so a driver cannot
/// point a run at a session by naming it. A host may give each workload one
/// session, or bind a session per conversation.
///
/// An agent must not rely on in-memory state surviving between runs: the
/// next run may be served by another instance, or bound to another session.
/// Everything it needs to continue is in its session.
///
/// One run at a time per session, because two runs in one session would
/// interleave one conversation. The driver holds the lock: it serializes runs
/// for the session and never calls `run` while one is in progress there. The
/// agent checks too, as a backstop against two drivers on one session, and
/// returns `busy`. The rule is about the session, not the instance: an agent
/// whose host binds a session per conversation may run one run in each of
/// several sessions at once.
///
/// People and approvals. An agent never receives, answers or enforces an
/// approval. Approvals happen at the gates the host owns, tool dispatch and
/// egress: a `tools.call` the host holds while it asks a person simply waits,
/// then returns the tool's result, or `not-dispatched(denied)` when the person
/// refuses. A question for the person is a tool the host may offer on the
/// agent's `tools` import; when no one can answer during the run, the agent
/// finishes `input-required`. Time spent waiting on a person counts toward
/// `run-options.max-duration`, and a host caps each wait at what the run has
/// left.
///
/// Journal. A run keeps the session conventions in `session`: the agent
/// writes the person's message and every step as `agent.step.v1` entries, and
/// each model or tool call between `agent.op.v1` and `agent.op-result.v1`.
/// It also writes `agent.run.v1` (`run`: the run id) in the commit that opens
/// the run, with the person's message, using `run:<run-id>` as that commit's
/// `commit-id`, and `agent.run-result.v1` (`run`, and `outcome`: done, failed
/// or cancelled, with `finish` or the error case) in the commit that ends it.
/// Each `agent.step.v1` the run writes carries `run` too. The events a run
/// streams are a live view of what it commits; the journal is the record,
/// and a reopened conversation is drawn from it.
@unstable(feature = agent-run)
interface run {
  @unstable(feature = agent-run)
  use inference-types.{user-message};
  @unstable(feature = agent-run)
  use run-types.{run-options, started-run, start-error};

  /// Start one run: take the message and work until the agent replies, a
  /// limit in `options` ends it, it fails, or the driver cancels it.
  ///
  /// Resolves once the run is accepted, not when it ends: the agent has
  /// committed the person's message and `agent.run.v1` to the session, so a
  /// run that fails or is cancelled later still shows what was asked.
  /// Returns `start-error` without starting and without writing: `busy`
  /// while a run is in progress (and after a cancellation, until that run
  /// has actually stopped, so two runs never overlap), `duplicate` for a
  /// `run-id` already started, `invalid-input` for a message or options it
  /// cannot take.
  ///
  /// Once started, the agent streams events as it works and resolves the
  /// outcome after its last commit, so a driver that redraws from the
  /// journal when the outcome arrives finds the run recorded. Dropping the
  /// events stream requests cancellation: the agent stops its model and tool
  /// calls, records each one as the session conventions say (cancelled, or
  /// unresolved when its effects are unknown), and resolves the outcome to
  /// `cancelled` only once nothing of the run is still running. The host,
  /// when it cancels a run, completes every pending call it serves for that
  /// run (a held tool call, a question waiting on a person) with
  /// `cancelled` right away, so the agent is not left waiting on them.
  /// Dropping the outcome future as well stops listening; the agent still
  /// winds the run down and records it.
  @unstable(feature = agent-run)
  run: async func(message: user-message, options: run-options) -> result<started-run, start-error>;
}

/// An append-only journal and opaque agent state, scoped by the host to the
/// caller. The host chooses the session a caller works in (one per workload,
/// or one per conversation) and binds it; the caller never names one. The
/// host decides which components may access it, stamps authors and
/// timestamps, and deletes the session when its scope ends.
///
/// Commits apply entries and state atomically. State writes require both state
/// and journal-end conditions; entry-only writes may omit them. A failed
/// condition returns stale with the current snapshot and writes nothing.
/// State.through records the journal end covered by that state.
///
/// Write each op conditionally before dispatch and its result after return.
/// Never advance state past an unresolved op. On restart, read after through:
/// - Model calls may repeat: close the old op as cancelled and create a new op.
/// - Tool calls may repeat with the same id and arguments only when workload
///   configuration authorizes repeat detection. Tool annotations cannot authorize it.
/// - Otherwise record unresolved and an error step for a person to resolve.
///   Never use a new id to bypass an unresolved tool call.
///
/// After a stale result, merge using the current state and journal. Already
/// executed calls must be recorded, even if that requires an unconditional
/// entry-only commit. A writer that cannot merge preserves the current state
/// and leaves its work in the journal. Use commit-id to retry a lost reply.
///
/// Reserved JSON entry conventions; the host stores data as opaque bytes:
/// - agent.step.v1: role (user, assistant, tool, error), text, blocks, and tools.
///   blocks names content kinds such as text, toolRequest, toolResponse, image,
///   thinking, and error. Other kinds are allowed; readers skip unknown kinds.
/// - agent.op.v1: op, target (model or tool), name, and tool arguments as a JSON
///   value; a freeform tool's raw text is a JSON string. Tool ops use the tool-call id; model ops use a session-unique id.
/// - agent.op-result.v1: op and outcome. succeeded/failed means the call returned;
///   cancelled means it was not dispatched or a model call will repeat;
///   unresolved means its effects are unknown.
/// - agent.context-reset.v1: {} when unreadable saved state requires fresh context.
/// - agent.run.v1: run, the run id, in the commit that opens a run of the
///   `run` interface, with the person's message; that commit's commit-id is
///   run:<run-id>. Every agent.step.v1 written by a run carries run as well.
/// - agent.run-result.v1: run, and outcome (done, failed, or cancelled) with
///   finish or error, in the commit that ends the run. finish input-required
///   means the run stopped for a person's answer, which starts the next run.
///   A run with agent.run.v1 and no agent.run-result.v1 was cut off.
/// - agent.compact.v1: compact, the id the driver gave the compact
///   interface, and optional focus, in the commit that accepts a requested
///   compaction, before its first model call; that commit's commit-id is
///   compact:<compact>. Compaction ids are a namespace apart from run ids.
/// - agent.compact-result.v1: compact, outcome (done, failed, or cancelled)
///   with finish or error, and compacted (true when the compaction wrote
///   agent.compaction.v1). At most one ends every accepted compaction; when
///   compacted is true it shares a commit with that agent.compaction.v1 and
///   the replacement state. An agent.compact.v1 with no
///   agent.compact-result.v1 was cut off (a crash), which a driver treats as
///   failed.
/// - agent.compaction.v1: summary, model, trigger, through, kept,
///   tokensBefore, tokensAfter, and optional focus. The agent replaced older
///   context with summary, which model wrote. trigger says why: threshold,
///   overflow, or requested (the driver called compact). through is
///   {start, end}, the inclusive seq range it covers; kept counts recent
///   messages carried over verbatim. Token counts are estimates, omitted when
///   unknown. focus, present only when requested, is the person's text saying
///   what the summary should keep. Commit it with the smaller state, and, for
///   a requested compaction, with its agent.compact-result.v1. A summary call
///   that ended refusal or content-filter is never written as one. Earlier
///   entries stay; the summary is model output, so never treat it as system
///   or user text. A run streams the same fields, without summary, model and
///   focus, as run-event compacted (run-types compaction-info). Readers skip
///   fields they do not understand.
/// - agent.plan.v1: entries, the agent's whole current plan as a list of
///   {content, status} with status pending, in-progress or completed, and
///   run when written by a run. It replaces any earlier agent.plan.v1, so
///   the latest one in the journal is the current plan; an empty list
///   clears it. Commit it before streaming run-event plan, with the step
///   that produced it when there is one, so a reader that reloads sees the
///   plan a live driver showed. It is agent text for display: never treat it
///   as verified progress, a commitment, or instructions.
/// All agent.* kinds are reserved. Writers may define other kinds; readers
/// skip those they do not understand.
///
/// Limits reject writes without truncation. A full session requires clear.
/// Versions are opaque and never reused, including after clear. Sequence
/// numbers increase, may have gaps, and are never reused. Resume reads at
/// seq + 1; do not infer sequence numbers otherwise.
@since(version = 0.3.0)
interface session {
  /// Opaque state version. Only equality is meaningful.
  type version = string;

  /// Which limit a write would have passed.
  enum limit-scope {
    /// One entry, or the state.
    entry,
    /// Everything this session holds.
    session,
    /// Everything the host holds for all sessions.
    host,
  }

  /// A write that would pass a limit.
  record too-large {
    scope: limit-scope,
    /// The limit, in bytes.
    limit: u64,
    /// Index of an oversized entry. None identifies state or an aggregate limit.
    entry: option<u32>,
  }

  variant error {
    too-large(too-large),
    /// Malformed arguments, such as a state write missing either condition.
    invalid-argument(string),
    /// The host could not serve the call; the detail is for logs.
    unavailable(string),
    other(string),
  }

  /// One journal entry.
  record entry {
    /// Increasing, never reused. Resume reading at seq + 1.
    seq: u64,
    /// Stable writing-component identity stamped by the host, not the writer.
    author: string,
    /// When the host accepted it, in milliseconds since the Unix epoch.
    at-ms: u64,
    /// Reserved or writer-defined entry kind. Data uses this kind's format.
    kind: string,
    data: list<u8>,
  }

  /// An entry to append.
  record new-entry {
    kind: string,
    data: list<u8>,
  }

  /// Where the journal ends.
  variant journal-end {
    /// The journal has no entries.
    empty,
    /// The last entry is this one.
    at(u64),
  }

  /// Opaque working state in the agent's format.
  record state {
    value: list<u8>,
    version: version,
    /// Journal end covered by this state, including entries in the same commit.
    through: journal-end,
  }

  /// Current state and journal end, returned by current and stale.
  record snapshot {
    /// `none` when no state has been written or the session was cleared.
    state: option<state>,
    end: journal-end,
  }

  /// What the state must be for a commit to apply.
  variant state-condition {
    /// No state exists. A conditional first write permits only one winner.
    absent,
    /// The state's current version is this one.
    version(version),
  }

  /// State writes require both conditions; entry-only writes may omit them.
  record commit-options {
    require-state: option<state-condition>,
    /// Required journal end. Each commit is atomic and totally ordered; this
    /// condition prevents another writer from interleaving between commits.
    require-end: option<journal-end>,
    /// Session-unique commit id, never a restartable counter. A retained duplicate
    /// returns its original result without writing. The host retains at least the
    /// most recent 1024 ids; clear forgets them.
    commit-id: option<string>,
  }

  /// What a commit wrote.
  record committed {
    /// Journal end after this commit; use as the next require-end.
    end: journal-end,
    /// The new state's version, when this commit wrote state.
    version: option<version>,
  }

  /// The outcome of a `commit`.
  variant commit-result {
    committed(committed),
    /// Condition mismatch. Writes nothing and returns the current snapshot.
    stale(snapshot),
  }

  /// Read the current state and journal end for the next commit's conditions.
  current: async func() -> result<snapshot, error>;

  /// Atomically append entries and optionally replace state. An empty commit
  /// checks conditions without writing.
  commit: async func(entries: list<new-entry>, state: option<list<u8>>, options: commit-options) -> result<commit-result, error>;

  /// Up to max entries with seq >= start, oldest first. Hosts may cap pages;
  /// a short page does not signal completion. Read until an empty page.
  read: async func(start: u64, max: u32) -> result<list<entry>, error>;

  /// Entries with seq >= start, oldest first, followed by new entries.
  /// Dropping the stream stops following; clear ends it.
  follow: async func(start: u64) -> result<stream<entry>, error>;

  /// Delete the journal, state, and retained commit ids. Versions and sequence
  /// numbers remain unreused. Old conditions fail, except empty and absent
  /// can match again after clear.
  clear: async func() -> result<_, error>;
}

/// Tool definitions, responses, and errors shared by tool callers and tool
/// providers. Function-less: importing it gives no permission, so a provider that
/// exports `tools` imports only these types, not the power to call tools.
/// Introduced in 0.4.0, when the records moved here from `tools`.
@since(version = 0.4.0)
interface tool-types {
  use inference-types.{json, tool-output, tool-input};

  /// Provider claims for display. Host permissions enforce access; these hints
  /// cannot authorize calls or retries.
  record tool-annotations {
    read-only: option<bool>,
    destructive: option<bool>,
    idempotent: option<bool>,
    /// Whether the tool interacts with the outside world.
    open-world: option<bool>,
  }

  /// Semantic version components.
  record semver-version {
    major: u64,
    minor: u64,
    patch: u64,
    /// Pre-release, e.g. `rc.1`.
    pre: option<string>,
    /// Build metadata, e.g. `20261006.abc123`.
    build: option<string>,
  }

  /// Provider-declared version, for display. The host's pinned component digest
  /// is authoritative for identifying the deployed build.
  variant tool-version {
    semver(semver-version),
    /// Provider-declared content hash.
    hash(string),
    /// Anything else, only meaningful to the provider.
    other(string),
  }

  /// Tool name, description, and input offered to the model.
  record tool-def {
    /// The model's selection key. `find_tools` and `load_tools` are reserved
    /// for a host's own discovery tools; a provider never uses them.
    name: string,
    /// Display label; name is the model's selection key.
    title: option<string>,
    description: string,
    /// What the model writes as the call's input: a JSON object matching
    /// a schema, text a grammar constrains, or plain text; see `tool-input`.
    input: tool-input,
    /// JSON Schema for `structured`, where the tool declares one.
    output-schema: option<json>,
    annotations: tool-annotations,
    /// The provider's own version for the tool, where it declares one.
    version: option<tool-version>,
  }

  /// The response returned by a tool.
  ///
  /// Output may be truncated. A host that dispatches the call may cap the
  /// size of a tool's output. When it cuts output, it appends a short text
  /// part saying so and stating the original size, and leaves the rest of
  /// the response as the tool returned it. Callers treat any output as
  /// possibly truncated and never assume it is the tool's complete result.
  record tool-response {
    /// What to show the model and the user, in order. May end with the
    /// host's truncation note.
    output: list<tool-output>,
    /// Machine-readable JSON matching output-schema when declared.
    structured: option<json>,
    /// The tool ran and failed. Return its output to the model as a normal result.
    is-error: bool,
  }

  /// This attempt did not start tool execution and produced no tool effects.
  variant dispatch-error {
    /// No tool by that name.
    unknown-tool(string),
    /// Arguments failed schema validation, or the tool rejected freeform
    /// input. The host does not check a grammar on the tool's behalf.
    invalid-arguments(string),
    /// Provider unavailable before execution could start.
    upstream(string),
    /// A person or policy refused execution.
    denied(string),
    cancelled,
    timed-out,
    /// Diagnostic detail; never parse it to determine dispatch state.
    other(string),
  }

  /// No terminal tool response was obtained; effects may have occurred.
  variant outcome-error {
    /// The provider or connection failed after dispatch may have occurred.
    upstream(string),
    /// Cancellation was requested; execution may continue.
    cancelled,
    /// The execution deadline elapsed; execution may continue.
    timed-out,
    /// Diagnostic detail; never parse it to determine effects.
    other(string),
  }

  /// Completed tool failures use tool-response.is-error.
  variant call-error {
    /// This attempt is confirmed not to have started execution.
    not-dispatched(dispatch-error),
    /// Dispatch or completion cannot be confirmed; effects remain unknown.
    outcome-unknown(outcome-error),
  }

  /// Why the tools could not be listed. A read has no effects to be unsure
  /// of, so it does not reuse call-error.
  variant list-error {
    /// The tools cannot be described now. Retry may succeed.
    unavailable(string),
    /// A person or policy refused to list tools to this caller.
    denied(string),
    /// Diagnostic detail; never parse it.
    other(string),
  }
}

/// Tool discovery and calls. The same interface is imported by an agent and
/// exported by a tool provider, so a provider links directly to an agent or
/// sits behind a host that lists and dispatches across several providers.
@since(version = 0.4.0)
interface tools {
  use inference-types.{tool-call};
  use tool-types.{tool-def, tool-response, call-error, list-error};

  /// All tools offered by this provider. Fails rather than returning an empty
  /// list when the tools cannot be described, so a caller can tell "none" from
  /// "unknown". A host listing several providers keeps offering one that stops
  /// after it was listed; calls to it fail instead. Fallible since 0.4.0.
  %list: async func() -> result<list<tool-def>, list-error>;

  /// Run a tool call. Its id correlates execution with the requesting turn.
  /// Retries reuse the same id and arguments; providers supporting repeat
  /// detection must reject the same id with different arguments.
  /// Retry an unknown outcome only with trusted repeat detection for this id.
  /// Dropping the pending call requests cooperative cancellation and may return
  /// no result. Without a terminal response, treat its effects as unknown.
  /// A host may cap the response's output and note the original size; see
  /// `tool-response`.
  call: async func(request: tool-call) -> result<tool-response, call-error>;
}

/// A provider owns the model resources used by its inference interfaces.
@since(version = 0.3.0)
world inference-provider {
  export inference-types;
  export model-admin;
  export chat;
  export embeddings;
}
/// A trusted serving component, such as an OpenAI-compatible server.
@since(version = 0.3.0)
world inference-client {
  import inference-types;
  import model-admin;
  import chat;
  import embeddings;
}
/// A provider that only serves chat.
@since(version = 0.3.0)
world chat-provider {
  export inference-types;
  export model-admin;
  export chat;
}
/// A provider that only serves embeddings.
@since(version = 0.3.0)
world embeddings-provider {
  export inference-types;
  export model-admin;
  export embeddings;
}
/// A sandboxed agent acquires models through workload-scoped aliases.
/// Model administration, credentials, and network permissions belong to the host.
/// Notifications require an explicit cosmonic:notify import and provider permission.
@since(version = 0.3.0)
world agent {
  import inference-types;
  import models;
  import chat;
  import tool-types;
  import tools;
  import session;
}
/// A tool's network and storage permissions belong to its provider component.
@since(version = 0.3.0)
world tool-provider {
  import inference-types;
  import tool-types;

  export tools;
}
/// An agent that can be handed runs: the `agent` world plus the `run`
/// export. A host drives it through the export, so it needs no ingress and
/// no protocol of its own. The world a child agent started by another
/// agent targets, too.
@unstable(feature = agent-run)
world runnable-agent {
  import inference-types;
  import models;
  import chat;
  import tool-types;
  import tools;
  import session;
  import wasi:clocks/types@0.3.0;
  import run-types;

  export run;
}
/// A runnable agent that can also summarize its context when its driver
/// asks: `runnable-agent` plus the `compact` export. Optional: a driver
/// that finds no `compact` export leaves compaction to the agent.
@unstable(feature = agent-run)
world compactable-agent {
  import inference-types;
  import models;
  import chat;
  import tool-types;
  import tools;
  import session;
  import wasi:clocks/types@0.3.0;
  import run-types;

  export compact;
  export run;
}
/// The power to drive an agent's runs. Holds only this import. For a
/// component that adapts another protocol onto an agent (an adapter that
/// imports `run` and exports `wasi:http/handler` to serve `POST /task`), or a
/// test double that plays the host.
@unstable(feature = agent-run)
world run-client {
  import inference-types;
  import wasi:clocks/types@0.3.0;
  import run-types;
  import run;
}
/// The power to drive an agent's runs and ask it to compact. `run-client`
/// plus the `compact` import, for a driver bound to a `compactable-agent`.
/// Kept apart from `run-client` so a component that only drives runs can
/// still be composed with an agent that does not export `compact`.
@unstable(feature = agent-run)
world compact-client {
  import wasi:clocks/types@0.3.0;
  import inference-types;
  import run-types;
  import compact;
  import run;
}
